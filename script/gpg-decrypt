#!/usr/bin/env bash

# Descriptografador GPG para uso com Thunar.
set -Eeuo pipefail

readonly ARQUIVO="${1:-}"
readonly SAIDA="${ARQUIVO%.gpg}"

pausar() {
    if [[ -t 0 ]]; then
        read -r -p "Pressione ENTER para sair..." _
    fi
}

if [[ -z "$ARQUIVO" || ! -f "$ARQUIVO" || "$ARQUIVO" != *.gpg ]]; then
    printf 'Uso: %s arquivo.gpg\n' "$0" >&2
    exit 1
fi

if [[ -e "$SAIDA" ]]; then
    printf 'O arquivo de saída já existe: %s\n' "$SAIDA" >&2
    pausar
    exit 1
fi

if gpg --output "$SAIDA" --decrypt -- "$ARQUIVO" && [[ -f "$SAIDA" ]]; then
    printf '\nArquivo descriptografado: %s\n' "$SAIDA"
else
    printf '\nFalha ao descriptografar: %s\n' "$ARQUIVO" >&2
    pausar
    exit 1
fi

pausar
