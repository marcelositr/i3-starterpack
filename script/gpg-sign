#!/usr/bin/env bash

# Assinador GPG para uso com Thunar.
set -Eeuo pipefail

readonly ARQUIVO="${1:-}"
readonly CHAVE="${GPG_SIGNING_KEY:-marcelost@riseup.net}"
readonly SAIDA="${ARQUIVO}.sig"

pausar() {
    if [[ -t 0 ]]; then
        read -r -p "Pressione ENTER para sair..." _
    fi
}

if [[ -z "$ARQUIVO" || ! -f "$ARQUIVO" ]]; then
    printf 'Uso: %s arquivo\n' "$0" >&2
    exit 1
fi

if [[ -e "$SAIDA" ]]; then
    printf 'O arquivo de saída já existe: %s\n' "$SAIDA" >&2
    pausar
    exit 1
fi

if gpg --output "$SAIDA" --local-user "$CHAVE" --detach-sign -- "$ARQUIVO" \
    && [[ -f "$SAIDA" ]]; then
    printf '\nAssinatura criada: %s\n' "$SAIDA"
else
    printf '\nFalha ao assinar: %s\n' "$ARQUIVO" >&2
    pausar
    exit 1
fi

pausar
