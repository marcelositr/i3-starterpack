#!/usr/bin/env bash

# Assinador GPG para uso com Thunar

ARQUIVO="$1"

# Coloque aqui o ID da sua chave privada GPG
CHAVE="marcelost@riseup.net"


if [ -z "$ARQUIVO" ]; then
    echo "Nenhum arquivo informado."
    echo
    read -p "Pressione ENTER para sair..."
    exit 1
fi


if [ ! -f "$ARQUIVO" ]; then
    echo "Arquivo não encontrado:"
    echo "$ARQUIVO"
    echo
    read -p "Pressione ENTER para sair..."
    exit 1
fi


echo "Arquivo:"
echo "$ARQUIVO"
echo

echo "Criando assinatura GPG..."
echo


gpg \
    --local-user "$CHAVE" \
    --detach-sign \
    "$ARQUIVO"


if [ $? -eq 0 ]; then
    echo
    echo "================================"
    echo " Assinatura criada com sucesso!"
    echo "================================"
    echo
    echo "Arquivo:"
    echo "${ARQUIVO}.sig"
else
    echo
    echo "Erro ao criar assinatura."
fi


echo
read -p "Pressione ENTER para fechar..."
