#!/usr/bin/env bash

set -Eeuo pipefail
IFS=$'\n\t'

readonly INSTALLER_VERSION="0.1.0"
readonly REPOSITORY="marcelositr/i3-starterpack"
readonly DEFAULT_REF="master"
readonly REPOSITORY_REF="${I3_STARTERPACK_REF:-$DEFAULT_REF}"

readonly -a PAYLOAD=(
    ".bashrc"
    ".profile"
    ".nanorc"
    ".face"
    ".config"
    ".nano"
    ".local/share"
    "script"
)

readonly -a PACKAGES=(
    "i3-wm"
    "i3status"
    "suckless-tools"
    "hsetroot"
    "scrot"
    "i3lock"
    "nano"
    "brightnessctl"
    "alsa-utils"
    "thunar"
    "xfce4-terminal"
    "exo-utils"
    "gocryptfs"
    "fuse3"
    "gnupg"
    "libimage-exiftool-perl"
    "papirus-icon-theme"
    "qt5ct"
    "qt6ct"
    "fonts-ibm-plex"
    "aspell"
    "aspell-pt-br"
)

MODE=""
SOURCE_ROOT=""
SOURCE_KIND=""
TEMP_DIR=""
BACKUP_DIR=""
INSTALL_STARTED=0
ROLLBACK_ACTIVE=0

NEW_PATHS=()
SAME_PATHS=()
CONFLICT_PATHS=()
TYPE_CONFLICT_PATHS=()
MISSING_PACKAGES=()

die() {
    printf 'ERRO: %s\n' "$*" >&2
    exit 1
}

warn() {
    printf 'AVISO: %s\n' "$*" >&2
}

usage() {
    cat <<'USAGE'
i3 Starterpack Installer

Uso:
  i3-starterpack-install --dry-run
  i3-starterpack-install --run
  i3-starterpack-install --help
  i3-starterpack-install --version

Opções:
  --dry-run   analisa o sistema e os arquivos sem alterar nada
  --run       repete a análise, pede confirmação, cria backup e instala
  --help      mostra esta ajuda
  --version   mostra a versão do instalador

Variável opcional:
  I3_STARTERPACK_REF=<branch>   usa outra branch ao baixar o repositório
USAGE
}

cleanup() {
    if [[ -n "$TEMP_DIR" && -d "$TEMP_DIR" ]]; then
        rm -rf -- "$TEMP_DIR"
    fi
}

safe_remove() {
    local path="$1"

    [[ -n "${HOME:-}" && "$HOME" != "/" ]] || die "HOME inválido; remoção recusada."
    [[ "$path" == "$HOME/"* && "$path" != "$HOME/" ]] || die "caminho inseguro recusado: $path"

    rm -rf -- "$path"
}

restore_backup_path() {
    local rel="$1"
    local source="$BACKUP_DIR/$rel"
    local destination="$HOME/$rel"

    [[ -e "$source" || -L "$source" ]] || return 0

    if [[ -e "$destination" || -L "$destination" ]]; then
        safe_remove "$destination"
    fi

    mkdir -p -- "$(dirname -- "$destination")"
    cp -a -- "$source" "$destination"
}

rollback() {
    local rel

    [[ "$INSTALL_STARTED" -eq 1 ]] || return 0

    ROLLBACK_ACTIVE=1
    warn "falha durante a instalação; restaurando os arquivos anteriores."

    for rel in "${NEW_PATHS[@]}" "${CONFLICT_PATHS[@]}"; do
        [[ -n "$rel" ]] || continue
        if [[ -e "$HOME/$rel" || -L "$HOME/$rel" ]]; then
            safe_remove "$HOME/$rel"
        fi
    done

    for rel in "${TYPE_CONFLICT_PATHS[@]}"; do
        [[ -n "$rel" ]] || continue
        if [[ -e "$HOME/$rel" || -L "$HOME/$rel" ]]; then
            safe_remove "$HOME/$rel"
        fi
    done

    if [[ -n "$BACKUP_DIR" && -d "$BACKUP_DIR" ]]; then
        for rel in "${TYPE_CONFLICT_PATHS[@]}" "${CONFLICT_PATHS[@]}"; do
            [[ -n "$rel" ]] || continue
            restore_backup_path "$rel" || true
        done
        warn "rollback concluído. O backup foi mantido em: $BACKUP_DIR"
    else
        warn "rollback concluído; os arquivos novos criados nesta tentativa foram removidos."
    fi
}

on_error() {
    local status=$?

    trap - ERR
    if [[ "$ROLLBACK_ACTIVE" -eq 0 ]]; then
        rollback || true
    fi
    exit "$status"
}

trap cleanup EXIT
trap on_error ERR

parse_args() {
    [[ $# -eq 1 ]] || {
        usage
        exit 2
    }

    case "$1" in
        --dry-run)
            MODE="dry-run"
            ;;
        --run)
            MODE="run"
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        --version)
            printf 'i3-starterpack-install %s\n' "$INSTALLER_VERSION"
            exit 0
            ;;
        *)
            usage
            exit 2
            ;;
    esac
}

check_user() {
    [[ "${EUID:-$(id -u)}" -ne 0 ]] || die "não execute este instalador como root ou com sudo."
    [[ -n "${HOME:-}" && "$HOME" != "/" ]] || die "HOME inválido."
    [[ -d "$HOME" && -w "$HOME" ]] || die "HOME não está disponível para escrita: $HOME"
}

check_system() {
    local os_id=""
    local os_name="desconhecido"
    local os_version="desconhecida"

    [[ "$(uname -s)" == "Linux" ]] || die "este starterpack foi preparado para Linux."
    [[ -r /etc/os-release ]] || die "não foi possível identificar a distribuição."

    # shellcheck disable=SC1091
    . /etc/os-release
    os_id="${ID:-}"
    os_name="${PRETTY_NAME:-${NAME:-desconhecido}}"
    os_version="${VERSION_ID:-desconhecida}"

    [[ "$os_id" == "debian" ]] || die "distribuição não suportada: $os_name. Este starterpack é destinado ao Debian."

    printf 'Sistema: %s\n' "$os_name"
    printf 'Versão detectada: %s\n' "$os_version"
    printf 'Usuário: %s\n' "${USER:-$(id -un)}"
    printf 'Home: %s\n' "$HOME"
}

download_source() {
    local archive_url
    local archive
    local extracted

    command -v tar >/dev/null 2>&1 || die "o comando tar é necessário para obter o starterpack."

    TEMP_DIR="$(mktemp -d -t i3-starterpack.XXXXXX)"
    archive="$TEMP_DIR/source.tar.gz"
    archive_url="https://github.com/${REPOSITORY}/archive/refs/heads/${REPOSITORY_REF}.tar.gz"

    printf 'Obtendo %s (%s)...\n' "$REPOSITORY" "$REPOSITORY_REF"

    if command -v curl >/dev/null 2>&1; then
        curl -fsSL "$archive_url" -o "$archive"
    elif command -v wget >/dev/null 2>&1; then
        wget -qO "$archive" "$archive_url"
    else
        die "curl ou wget é necessário para baixar o starterpack."
    fi

    tar -xzf "$archive" -C "$TEMP_DIR"
    extracted="$(find "$TEMP_DIR" -mindepth 1 -maxdepth 1 -type d -print -quit)"
    [[ -n "$extracted" ]] || die "o arquivo baixado não contém um diretório válido."

    SOURCE_ROOT="$extracted"
    SOURCE_KIND="GitHub:$REPOSITORY_REF"
}

prepare_source() {
    local script_path="${BASH_SOURCE[0]:-}"
    local candidate=""
    local item

    if [[ -n "$script_path" && -f "$script_path" ]]; then
        candidate="$(cd -- "$(dirname -- "$script_path")/.." 2>/dev/null && pwd || true)"
        if [[ -n "$candidate" && -f "$candidate/README.md" && -d "$candidate/.config/i3" ]]; then
            SOURCE_ROOT="$candidate"
            SOURCE_KIND="checkout local"
        fi
    fi

    if [[ -z "$SOURCE_ROOT" ]]; then
        download_source
    fi

    for item in "${PAYLOAD[@]}"; do
        [[ -e "$SOURCE_ROOT/$item" || -L "$SOURCE_ROOT/$item" ]] || die "item esperado ausente no starterpack: $item"
    done

    printf 'Fonte: %s\n' "$SOURCE_KIND"
}

validate_source() {
    printf 'Validando os arquivos do starterpack...\n'
    bash "$SOURCE_ROOT/script/validate" >/dev/null
    printf 'Validação do starterpack: OK\n'
}

check_packages() {
    local package

    MISSING_PACKAGES=()

    command -v dpkg-query >/dev/null 2>&1 || die "dpkg-query não foi encontrado."

    for package in "${PACKAGES[@]}"; do
        if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -q '^install ok installed$'; then
            MISSING_PACKAGES+=("$package")
        fi
    done
}

under_type_conflict() {
    local rel="$1"
    local conflict

    for conflict in "${TYPE_CONFLICT_PATHS[@]}"; do
        if [[ "$rel" == "$conflict" || "$rel" == "$conflict/"* ]]; then
            return 0
        fi
    done

    return 1
}

scan_files() {
    local item src path rel dest

    NEW_PATHS=()
    SAME_PATHS=()
    CONFLICT_PATHS=()
    TYPE_CONFLICT_PATHS=()

    for item in "${PAYLOAD[@]}"; do
        src="$SOURCE_ROOT/$item"

        if [[ -d "$src" && ! -L "$src" ]]; then
            while IFS= read -r -d '' path; do
                rel="${path#"$SOURCE_ROOT/"}"
                dest="$HOME/$rel"

                if [[ -e "$dest" || -L "$dest" ]]; then
                    if [[ ! -d "$dest" || -L "$dest" ]]; then
                        TYPE_CONFLICT_PATHS+=("$rel")
                    fi
                fi
            done < <(find "$src" -type d -print0)
        fi
    done

    for item in "${PAYLOAD[@]}"; do
        src="$SOURCE_ROOT/$item"

        if [[ -d "$src" && ! -L "$src" ]]; then
            while IFS= read -r -d '' path; do
                rel="${path#"$SOURCE_ROOT/"}"
                dest="$HOME/$rel"

                if under_type_conflict "$rel"; then
                    continue
                fi

                if [[ ! -e "$dest" && ! -L "$dest" ]]; then
                    NEW_PATHS+=("$rel")
                elif [[ -f "$path" && ! -L "$path" && -f "$dest" && ! -L "$dest" ]] && cmp -s -- "$path" "$dest"; then
                    SAME_PATHS+=("$rel")
                elif [[ -L "$path" && -L "$dest" && "$(readlink -- "$path")" == "$(readlink -- "$dest")" ]]; then
                    SAME_PATHS+=("$rel")
                else
                    CONFLICT_PATHS+=("$rel")
                fi
            done < <(find "$src" \( -type f -o -type l \) -print0)
        else
            rel="$item"
            dest="$HOME/$rel"

            if [[ ! -e "$dest" && ! -L "$dest" ]]; then
                NEW_PATHS+=("$rel")
            elif [[ -f "$src" && ! -L "$src" && -f "$dest" && ! -L "$dest" ]] && cmp -s -- "$src" "$dest"; then
                SAME_PATHS+=("$rel")
            elif [[ -L "$src" && -L "$dest" && "$(readlink -- "$src")" == "$(readlink -- "$dest")" ]]; then
                SAME_PATHS+=("$rel")
            else
                CONFLICT_PATHS+=("$rel")
            fi
        fi
    done
}

check_disk() {
    local source_kb=0 available_kb item item_kb

    for item in "${PAYLOAD[@]}"; do
        item_kb="$(du -sk "$SOURCE_ROOT/$item" | awk '{print $1}')"
        source_kb=$((source_kb + item_kb))
    done
    available_kb="$(df -Pk "$HOME" | awk 'NR==2 {print $4}')"

    printf 'Starterpack: aproximadamente %d MiB\n' "$(( (source_kb + 1023) / 1024 ))"
    printf 'Espaço livre no HOME: aproximadamente %d MiB\n' "$(( available_kb / 1024 ))"

    if (( available_kb < source_kb + 51200 )); then
        die "espaço livre insuficiente para uma instalação segura."
    fi
}

print_plan() {
    local path

    printf '\n=== PLANO DE INSTALAÇÃO ===\n'
    printf 'Novos: %d\n' "${#NEW_PATHS[@]}"
    printf 'Idênticos: %d\n' "${#SAME_PATHS[@]}"
    printf 'Conflitos de conteúdo: %d\n' "${#CONFLICT_PATHS[@]}"
    printf 'Conflitos de tipo: %d\n' "${#TYPE_CONFLICT_PATHS[@]}"
    printf 'Pacotes ausentes: %d\n' "${#MISSING_PACKAGES[@]}"

    if ((${#MISSING_PACKAGES[@]} > 0)); then
        printf '\nPacotes que serão instalados no --run:\n'
        for path in "${MISSING_PACKAGES[@]}"; do
            printf '  + %s\n' "$path"
        done
    fi

    if ((${#TYPE_CONFLICT_PATHS[@]} > 0)); then
        printf '\nConflitos de tipo:\n'
        for path in "${TYPE_CONFLICT_PATHS[@]}"; do
            printf '  ! ~/%s\n' "$path"
        done
    fi

    if ((${#CONFLICT_PATHS[@]} > 0)); then
        printf '\nArquivos existentes que serão substituídos após backup:\n'
        for path in "${CONFLICT_PATHS[@]}"; do
            printf '  ! ~/%s\n' "$path"
        done
    fi

    if ((${#CONFLICT_PATHS[@]} == 0 && ${#TYPE_CONFLICT_PATHS[@]} == 0)); then
        printf '\nNenhum arquivo conflitante foi encontrado.\n'
    fi
}

confirm_run() {
    local answer=""

    [[ -r /dev/tty && -w /dev/tty ]] || die "--run precisa de um terminal interativo para confirmação."

    printf '\nSe continuar, os pacotes ausentes serão instalados e todo conflito será salvo em backup antes da substituição.\n' > /dev/tty
    printf 'Continuar com a instalação? [s/N] ' > /dev/tty
    IFS= read -r answer < /dev/tty || answer=""

    case "${answer,,}" in
        s|sim|y|yes)
            ;;
        *)
            printf 'Instalação abortada. Nenhum arquivo do HOME foi alterado.\n'
            exit 0
            ;;
    esac
}

install_packages() {
    if ((${#MISSING_PACKAGES[@]} == 0)); then
        printf 'Dependências: OK\n'
        return 0
    fi

    command -v sudo >/dev/null 2>&1 || die "há pacotes ausentes, mas sudo não está instalado. Instale-os manualmente e execute novamente."
    command -v apt-get >/dev/null 2>&1 || die "apt-get não foi encontrado."

    printf 'Atualizando índice de pacotes...\n'
    sudo apt-get update

    printf 'Instalando dependências ausentes...\n'
    sudo apt-get install -y -- "${MISSING_PACKAGES[@]}"
}

create_backup() {
    local stamp rel destination backup_target

    if ((${#CONFLICT_PATHS[@]} == 0 && ${#TYPE_CONFLICT_PATHS[@]} == 0)); then
        return 0
    fi

    stamp="$(date '+%Y-%m-%d_%H%M%S')"
    BACKUP_DIR="$HOME/.local/share/i3-starterpack/backups/$stamp"
    if [[ -e "$BACKUP_DIR" ]]; then
        BACKUP_DIR="${BACKUP_DIR}_$$"
    fi

    umask 077
    mkdir -p -- "$BACKUP_DIR"

    {
        printf 'i3 Starterpack backup\n'
        printf 'created=%s\n' "$(date --iso-8601=seconds)"
        printf 'installer_version=%s\n' "$INSTALLER_VERSION"
        printf 'source=%s\n' "$SOURCE_KIND"
        printf '\npaths:\n'
    } > "$BACKUP_DIR/manifest.txt"

    for rel in "${TYPE_CONFLICT_PATHS[@]}" "${CONFLICT_PATHS[@]}"; do
        [[ -n "$rel" ]] || continue
        destination="$HOME/$rel"
        backup_target="$BACKUP_DIR/$rel"

        [[ -e "$destination" || -L "$destination" ]] || continue
        mkdir -p -- "$(dirname -- "$backup_target")"
        cp -a -- "$destination" "$backup_target"
        printf '%s\n' "$rel" >> "$BACKUP_DIR/manifest.txt"
    done

    printf 'Backup criado em: %s\n' "$BACKUP_DIR"
}

install_payload() {
    local item src path rel dest

    INSTALL_STARTED=1

    for rel in "${TYPE_CONFLICT_PATHS[@]}"; do
        dest="$HOME/$rel"
        if [[ -e "$dest" || -L "$dest" ]]; then
            safe_remove "$dest"
        fi
    done

    for item in "${PAYLOAD[@]}"; do
        src="$SOURCE_ROOT/$item"

        if [[ -d "$src" && ! -L "$src" ]]; then
            while IFS= read -r -d '' path; do
                rel="${path#"$SOURCE_ROOT/"}"
                mkdir -p -- "$HOME/$rel"
            done < <(find "$src" -type d -print0)

            while IFS= read -r -d '' path; do
                rel="${path#"$SOURCE_ROOT/"}"
                dest="$HOME/$rel"

                if [[ -e "$dest" || -L "$dest" ]]; then
                    if [[ -f "$path" && ! -L "$path" && -f "$dest" && ! -L "$dest" ]] && cmp -s -- "$path" "$dest"; then
                        continue
                    fi
                    if [[ -L "$path" && -L "$dest" && "$(readlink -- "$path")" == "$(readlink -- "$dest")" ]]; then
                        continue
                    fi
                    safe_remove "$dest"
                fi

                mkdir -p -- "$(dirname -- "$dest")"
                cp -a -- "$path" "$dest"
            done < <(find "$src" \( -type f -o -type l \) -print0)
        else
            rel="$item"
            dest="$HOME/$rel"

            if [[ -e "$dest" || -L "$dest" ]]; then
                if [[ -f "$src" && ! -L "$src" && -f "$dest" && ! -L "$dest" ]] && cmp -s -- "$src" "$dest"; then
                    continue
                fi
                if [[ -L "$src" && -L "$dest" && "$(readlink -- "$src")" == "$(readlink -- "$dest")" ]]; then
                    continue
                fi
                safe_remove "$dest"
            fi

            mkdir -p -- "$(dirname -- "$dest")"
            cp -a -- "$src" "$dest"
        fi
    done
}

verify_installation() {
    local item src path rel dest failures=0

    printf 'Verificando arquivos instalados...\n'

    for item in "${PAYLOAD[@]}"; do
        src="$SOURCE_ROOT/$item"

        if [[ -d "$src" && ! -L "$src" ]]; then
            while IFS= read -r -d '' path; do
                rel="${path#"$SOURCE_ROOT/"}"
                dest="$HOME/$rel"

                if [[ -f "$path" && ! -L "$path" ]]; then
                    if [[ ! -f "$dest" || -L "$dest" ]] || ! cmp -s -- "$path" "$dest"; then
                        warn "verificação falhou: ~/$rel"
                        failures=$((failures + 1))
                    fi
                elif [[ -L "$path" ]]; then
                    if [[ ! -L "$dest" || "$(readlink -- "$path")" != "$(readlink -- "$dest" 2>/dev/null || true)" ]]; then
                        warn "verificação falhou: ~/$rel"
                        failures=$((failures + 1))
                    fi
                fi
            done < <(find "$src" \( -type f -o -type l \) -print0)
        else
            rel="$item"
            dest="$HOME/$rel"

            if [[ -f "$src" && ! -L "$src" ]]; then
                if [[ ! -f "$dest" || -L "$dest" ]] || ! cmp -s -- "$src" "$dest"; then
                    warn "verificação falhou: ~/$rel"
                    failures=$((failures + 1))
                fi
            elif [[ -L "$src" ]]; then
                if [[ ! -L "$dest" || "$(readlink -- "$src")" != "$(readlink -- "$dest" 2>/dev/null || true)" ]]; then
                    warn "verificação falhou: ~/$rel"
                    failures=$((failures + 1))
                fi
            fi
        fi
    done

    ((failures == 0)) || return 1

    if command -v fc-cache >/dev/null 2>&1; then
        fc-cache -f >/dev/null
    fi

    INSTALL_STARTED=0
    printf 'Verificação: OK\n'
}

main() {
    parse_args "$@"
    check_user

    printf 'i3 Starterpack Installer %s\n\n' "$INSTALLER_VERSION"

    check_system
    prepare_source
    validate_source
    check_packages
    scan_files
    check_disk
    print_plan

    if [[ "$MODE" == "dry-run" ]]; then
        printf '\nDry run concluído. Nenhuma alteração foi realizada.\n'
        exit 0
    fi

    confirm_run
    install_packages
    create_backup
    install_payload
    verify_installation

    printf '\nInstalação concluída com sucesso.\n'
    if [[ -n "$BACKUP_DIR" ]]; then
        printf 'Backup: %s\n' "$BACKUP_DIR"
    fi
}

main "$@"
