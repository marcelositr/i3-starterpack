#!/usr/bin/env bash

set -Eeuo pipefail

readonly ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

bash ./script/validate-quick

readonly -a SHELL_FILES=(
    .bashrc
    .profile
    script/gpg-crypt
    script/gpg-decrypt
    script/gpg-sign
    script/screenshot
    script/validate
    script/validate-quick
    script/test-installer
    script/i3-starterpack-install
)

require_validator() {
    local command_name="$1"

    if command -v "$command_name" >/dev/null 2>&1; then
        return 0
    fi

    if [[ "${I3_STARTERPACK_STRICT_CI:-0}" == "1" ]]; then
        printf 'Validador obrigatório ausente: %s\n' "$command_name" >&2
        exit 1
    fi

    return 1
}

if require_validator shellcheck; then
    shellcheck --severity=error "${SHELL_FILES[@]}"
fi

if require_validator xmllint; then
    xmllint --noout \
        .config/Thunar/uca.xml \
        .config/xfce4/xfconf/xfce-perchannel-xml/thunar.xml \
        .config/xfce4/xfconf/xfce-perchannel-xml/xfce4-terminal.xml
fi

if require_validator i3; then
    i3 -C -c .config/i3/config
fi

printf 'Validações completas concluídas.\n'
